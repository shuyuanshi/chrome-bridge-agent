# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.uv-cache/

# uv: lockfile IS committed so CI is reproducible.
# Only one runtime dep (websockets), so this won't constrain downstream users.

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.basedpyright/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local secrets / cookie jars (see references/cookie-injection-auth.md)
private/
*cookies*.json
.chrome-bridge-token
.env
.env.*

# Captured page content. `chrome-bridge screenshot` writes screenshot.png into
# the cwd by default, and a screenshot of a logged-in page is every bit as
# sensitive as a cookie jar.
*.png
*.har

# Runtime logs
*.log

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build artefacts
build/
dist/
*.tgz
